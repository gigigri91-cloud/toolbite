---
export interface Props {
  items: Array<{ question: string; answer: string }>;
}
const { items } = Astro.props;
---

<section class="tb-card tb-card-panel tb-card-pad-lg tb-tool-section">
  <h2 class="tb-tool-section__title">FAQ</h2>
  <div class="tb-tool-faq-list">
    {items.map((item) => (
      <details class="tb-tool-faq-item">
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .tb-tool-faq-list {
    display: grid;
    gap: 0.625rem;
  }
  .tb-tool-faq-item {
    border: 1px solid var(--border-default, rgba(255,255,255,0.07));
    border-radius: 0.9rem;
    padding: 0.7rem 0.9rem;
    background: var(--bg-card-hover, #192338);
    transition: border-color 160ms ease;
  }
  .tb-tool-faq-item:hover {
    border-color: var(--border-strong, rgba(74,159,224,0.18));
  }
  .tb-tool-faq-item summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text-primary, #E8EDFB);
    list-style: none;
  }
  .tb-tool-faq-item summary::-webkit-details-marker { display: none; }
  .tb-tool-faq-item summary::before {
    content: '▸ ';
    color: var(--accent-blue, #4A9FE0);
    font-size: 0.8em;
  }
  .tb-tool-faq-item[open] summary::before {
    content: '▾ ';
  }
  .tb-tool-faq-item p {
    margin: 0.6rem 0 0;
    color: var(--text-secondary, #8BA3C4);
    font-size: 0.9rem;
    line-height: 1.6;
  }
</style>
