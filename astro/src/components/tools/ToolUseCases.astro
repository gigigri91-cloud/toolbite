---
export interface Props {
  items: Array<{ title: string; description: string }>;
}
const { items } = Astro.props;
---

<section class="tb-card tb-card-panel tb-card-pad-lg tb-tool-section">
  <h2 class="tb-tool-section__title">Use cases</h2>
  <div class="tb-tool-usecase-grid">
    {items.map((item) => (
      <article class="tb-card tb-card-pad-md tb-tool-usecase-item">
        <h3>{item.title}</h3>
        <p>{item.description}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .tb-tool-usecase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.75rem;
  }
  .tb-tool-usecase-item h3 {
    margin: 0 0 0.45rem;
    font-size: 0.95rem;
    color: var(--accent-blue, #4A9FE0);
    font-weight: 700;
  }
  .tb-tool-usecase-item p {
    margin: 0;
    color: var(--text-secondary, #8BA3C4);
    font-size: 0.875rem;
    line-height: 1.55;
  }
</style>
