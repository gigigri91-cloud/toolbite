---
export interface Props {
  title?: string;
  privacyNote?: string;
}

const { title = "Use the tool", privacyNote } = Astro.props;
---

<section class="tb-tool-interface-wrapper">
  <header class="tb-tool-interface-wrapper__head">
    <h2 class="tb-tool-interface-wrapper__title">{title}</h2>
    {privacyNote && <p class="tb-tool-interface-wrapper__privacy">{privacyNote}</p>}
  </header>
  <slot />
</section>

<style>
  .tb-tool-interface-wrapper {
    margin-bottom: 1.5rem;
    background: var(--bg-primary, #090e18);
    border: 1px solid var(--border-default, rgba(255,255,255,0.07));
    border-radius: 10px;
    padding: 1.25rem 1.35rem;
  }
  .tb-tool-interface-wrapper__head {
    margin-bottom: 1rem;
  }
  .tb-tool-interface-wrapper__title {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    color: var(--text-primary, #E8EDFB);
  }
  .tb-tool-interface-wrapper__privacy {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    color: var(--text-muted, #7A8BAD);
  }
  .tb-tool-interface-wrapper :global(textarea.tb-textarea) {
    background: var(--bg-card, #141D2E) !important;
    border: 1px solid var(--border-default, rgba(255,255,255,0.07)) !important;
    color: var(--text-primary, #E8EDFB) !important;
  }
</style>
