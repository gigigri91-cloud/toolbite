---
import ToolCard from "@/components/discovery/ToolCard.astro";
import type { NormalizedTool } from "@/lib/tools";

export interface Props {
  title: string;
  subtitle?: string;
  tools: NormalizedTool[];
}

const { title, subtitle, tools } = Astro.props;
---

<section class="tb-card tb-card-panel tb-card-pad-lg discovery-section">
  <div class="discovery-header">
    <h2 class="wow-discovery-title">{title}</h2>
    {subtitle && <p class="wow-discovery-sub">{subtitle}</p>}
  </div>
  <div class="discovery-grid">
    {tools.map((tool) => <ToolCard tool={tool} />)}
  </div>
</section>

<style>
  .discovery-section { margin-bottom: 1.5rem; }
  .discovery-header { margin-bottom: 1rem; }
  .wow-discovery-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-primary, #E8EDFB);
    letter-spacing: -0.02em;
  }
  .wow-discovery-sub {
    margin: 0.35rem 0 0;
    font-size: 0.875rem;
    color: var(--text-secondary, var(--color-text-secondary));
    line-height: 1.5;
  }
  .discovery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 768px) { .discovery-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
