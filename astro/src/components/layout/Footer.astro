---
export interface Props {
  rootPath?: string;
}

const { rootPath = "/" } = Astro.props;
---

<footer id="site-footer" class="tb-shell-footer">
  <div class="tb-footer-inner">
    <div class="tb-footer-grid">

      <!-- Coloana 1: Brand -->
      <div class="tb-footer-col tb-footer-brand">
        <a href={`${rootPath}`} class="tb-footer-logo-link" aria-label="ToolBite home">
          <span class="footer-logo-icon" aria-hidden="true">🔧</span>
          <span class="footer-logo-text">Tool<span class="footer-logo-bite">Bite</span></span>
        </a>
        <p class="tb-footer-tagline">Browser tools that respect your time and privacy.</p>
        <a href="#" id="random-tool-btn" class="tb-footer-random-btn" aria-label="Open a random tool">
          <span aria-hidden="true">🎲</span> Random tool
        </a>
      </div>

      <!-- Coloana 2: Explore -->
      <div class="tb-footer-col">
        <p class="tb-footer-col-title">Explore</p>
        <nav aria-label="Explore tools">
          <a href={`${rootPath}search.html`}>Search all tools</a>
          <a href={`${rootPath}categories/`}>All categories</a>
          <a href={`${rootPath}categories/developer-tools.html`}>Developer tools</a>
          <a href={`${rootPath}categories/text-tools.html`}>Text tools</a>
          <a href={`${rootPath}categories/image-tools.html`}>Image tools</a>
          <a href={`${rootPath}categories/seo-tools.html`}>SEO tools</a>
          <a href="/guides/">Guides</a>
        </nav>
      </div>

      <!-- Coloana 3: Legal & info -->
      <div class="tb-footer-col">
        <p class="tb-footer-col-title">Legal & info</p>
        <nav aria-label="Legal">
          <a href={`${rootPath}about.html`}>About</a>
          <a href={`${rootPath}contact.html`}>Contact</a>
          <a href={`${rootPath}editorial-policy.html`}>Editorial policy</a>
          <a href={`${rootPath}privacy.html`}>Privacy policy</a>
          <a href={`${rootPath}cookie-policy.html`}>Cookie policy</a>
          <a href={`${rootPath}terms.html`}>Terms of use</a>
          <a href={`${rootPath}privacy.html#ads`} data-open-cookie-settings="true">Manage cookies</a>
        </nav>
      </div>

    </div>

    <p class="tb-footer-copy">
      &copy; <span id="current-year"></span> ToolBite.org — all rights reserved.
    </p>
  </div>
</footer>

<script is:inline>
  (function() {
    var tools = ["tools/base64-encoder.html","tools/csv-to-json.html","tools/case-converter.html","tools/color-palette-generator.html","tools/find-replace.html","tools/image-compressor.html","tools/json-formatter.html","tools/jwt-decoder.html","tools/lorem-ipsum.html","tools/password-generator.html","tools/qr-generator.html","tools/read-time-calculator.html","tools/remove-duplicate-lines.html","tools/remove-extra-spaces.html","tools/hash-generator.html","tools/sort-text-lines.html","tools/text-to-slug.html","tools/url-encoder.html","tools/uuid-generator.html","tools/word-counter.html"];
    var btn = document.getElementById('random-tool-btn');
    if (btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var pick = tools[Math.floor(Math.random() * tools.length)];
        window.location.href = '/' + pick;
      });
    }
    var yr = document.getElementById('current-year');
    if (yr) yr.textContent = new Date().getFullYear();
  })();
</script>

<style>
  .tb-shell-footer {
    margin-top: 3rem;
    background: var(--bg-primary, var(--color-bg-primary));
    border-top: 1px solid var(--border-subtle, var(--color-border-primary));
  }
  .tb-footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.25rem 1.25rem;
  }
  .tb-footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 2rem;
    margin-bottom: 1.75rem;
  }
  @media (max-width: 720px) {
    .tb-footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .tb-footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 420px) {
    .tb-footer-grid {
      grid-template-columns: 1fr;
    }
  }
  .tb-footer-col-title {
    margin: 0 0 0.65rem;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted, #7A8BAD);
  }
  .tb-footer-col nav {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .tb-footer-col nav a {
    color: var(--text-secondary, #8BA3C4);
    text-decoration: none;
    font-size: 0.875rem;
    line-height: 1.4;
    transition: color 140ms ease;
  }
  .tb-footer-col nav a:hover {
    color: var(--accent-blue, #4A9FE0);
  }
  .tb-footer-logo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    line-height: 1;
    margin-bottom: 0.6rem;
  }
  .footer-logo-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: linear-gradient(135deg, #1E6FC2, #F07820);
    border-radius: 7px;
    font-size: 0.9rem;
    flex-shrink: 0;
  }
  .footer-logo-text {
    font-family: 'Syne', 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-primary, #E8EDFB);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .footer-logo-bite { color: #FF9A45; }
  .tb-footer-tagline {
    margin: 0 0 0.75rem;
    color: var(--text-muted, #7A8BAD);
    font-size: 0.85rem;
    line-height: 1.5;
    max-width: 22ch;
  }
  .tb-footer-random-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent-blue, #4A9FE0);
    border: 1px solid rgba(74,159,224,0.25);
    border-radius: 6px;
    padding: 0.35rem 0.75rem;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    background: rgba(74,159,224,0.06);
    transition: background 160ms ease, border-color 160ms ease;
    white-space: nowrap;
  }
  .tb-footer-random-btn:hover {
    background: rgba(74,159,224,0.14);
    border-color: rgba(74,159,224,0.45);
  }
  .tb-footer-copy {
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle, rgba(255,255,255,0.04));
    color: var(--text-muted, #7A8BAD);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    text-align: center;
  }
</style>
