---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { createLegalMetadata } from "@/lib/seo";

const title = "Cookie Policy — ToolBite Free Online Tools";
const description =
  "Read the ToolBite cookie policy for categories, consent controls, third-party ads, analytics, and how to manage preferences in your browser on ToolBite today.";
const canonicalPath = "/cookie-policy.html";
const metadata = createLegalMetadata({
  title,
  description,
  canonicalPath,
  keywords: ["ToolBite cookies", "cookie policy", "consent", "AdSense", "analytics"]
});
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} rootPath="/" metadata={metadata}>
  <div class="static-page-shell">
    <div class="static-page-hero">
      <nav class="tb-breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/">Home</a></li>
          <li>›</li>
          <li class="breadcrumb-current">Cookie Policy</li>
        </ol>
      </nav>
      <div class="legal-hero">
        <h1 data-pseo-target="h1">ToolBite <span class="legal-hero__accent">Cookie Policy</span></h1>
      </div>
    </div>

    <div class="static-page-cards">
      <div class="tb-card tb-card-tool legal-body-card">
        <h2 class="legal-h2">1. What Are Cookies</h2>
        <p class="legal-body">Cookies are small text files stored on your browser or device when you visit a website. They help websites remember settings, measure usage, and support features such as security and advertising. ToolBite uses cookies and similar storage technologies (such as local storage) to operate core features and, where enabled, improve analytics and ad relevance.</p>

        <h2 class="legal-h2">2. Types of Cookies We Use</h2>
        <p class="legal-body"><strong>Necessary cookies</strong> are required for core functionality and security. These include core preference storage and site operation helpers that keep essential functions available.</p>
        <p class="legal-body"><strong>Optional cookies</strong> help us understand traffic and usage patterns so we can improve tool quality, content clarity, and performance. On ToolBite, analytics technology may include Google Optional.</p>
        <p class="legal-body"><strong>Advertising cookies</strong> are used by ad partners such as Google AdSense to deliver ads, reduce repeated ads, and measure campaign effectiveness. These cookies may support ad personalization depending on provider settings and user controls.</p>

        <h2 class="legal-h2">3. Third-Party Cookies</h2>
        <p class="legal-body">ToolBite may load third-party services that set cookies under their own policies. Key examples include:</p>
        <ul class="legal-list">
          <li><strong>Google AdSense</strong> for ad delivery and reporting. Learn more at <a href="https://policies.google.com/technologies/ads" target="_blank" rel="nofollow noopener" class="legal-link">Google Ads Policy</a>.</li>
          <li><strong>Google Optional</strong> for aggregated traffic insights and site improvement. Learn more at <a href="https://policies.google.com/privacy" target="_blank" rel="nofollow noopener" class="legal-link">Google Privacy Policy</a>.</li>
        </ul>

        <h2 class="legal-h2">4. How to Control Cookies</h2>
        <p class="legal-body">You can control cookies in several ways:</p>
        <ul class="legal-list">
          <li>Use the ToolBite consent banner and Manage Preferences modal to choose analytics and advertising categories.</li>
          <li>Adjust browser settings to block or delete cookies in Chrome, Safari, Firefox, or Edge.</li>
          <li>Use Google account ad settings to manage personalized ad preferences.</li>
        </ul>
        <p class="legal-body">Blocking optional categories may reduce analytics visibility or ad relevance. Necessary functionality remains enabled for core site operation.</p>

        <h2 class="legal-h2">5. Cookie Retention Periods</h2>
        <p class="legal-body">Retention periods depend on cookie type and provider. Session cookies expire when your browser closes. Persistent cookies may remain for days or months unless you delete them sooner. Third-party providers such as Google define their own retention periods according to their policies.</p>

        <h2 class="legal-h2">6. Updates to This Policy</h2>
        <p class="legal-body">We may update this Cookie Policy to reflect legal, technical, or operational changes. We will update the "Last updated" date whenever changes are published.</p>

        <h2 class="legal-h2">7. Contact</h2>
        <p class="legal-body">If you have questions about this Cookie Policy or your cookie preferences, email <a href="mailto:contact@toolbite.org" class="legal-link">contact@toolbite.org</a> or use our <a href="contact.html" class="legal-link">contact page</a>.</p>
      </div>

      <section class="tb-card legal-nav-section">
        <h2 class="legal-h2-sm">Related policy pages</h2>
        <div class="legal-grid-3">
          <a href="privacy.html" class="tb-card tb-card-soft tb-card-pad-sm">
            <h3 class="legal-card__title">Privacy Policy</h3>
            <p class="legal-card__body">Read how ToolBite handles local processing, logs, and third-party services.</p>
          </a>
          <a href="terms.html" class="tb-card tb-card-soft tb-card-pad-sm">
            <h3 class="legal-card__title">Terms of Service</h3>
            <p class="legal-card__body">Understand the usage terms and service limitations for ToolBite.</p>
          </a>
          <a href="contact.html" class="tb-card tb-card-soft tb-card-pad-sm">
            <h3 class="legal-card__title">Contact</h3>
            <p class="legal-card__body">Reach out if you need help with cookies or privacy preferences.</p>
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    font-size: 0.875rem;
    color: var(--text-muted, #7A8BAD);
  }
  .breadcrumb-list a { color: var(--text-muted, #7A8BAD); text-decoration: none; transition: color 140ms; }
  .breadcrumb-list a:hover { color: var(--accent-blue, #4A9FE0); }
  .breadcrumb-current { color: var(--text-secondary, #8BA3C4); font-weight: 500; }

  .legal-hero { margin-bottom: 2rem; text-align: center; }
  .legal-hero h1 {
    font-size: clamp(1.8rem, 3vw + 1rem, 2.75rem);
    font-weight: 800;
    color: var(--text-primary, #E8EDFB);
    margin: 0;
    line-height: 1.1;
  }
  .legal-hero__accent { color: var(--accent-blue, #4A9FE0); }

  .legal-body-card { padding: 1.5rem; line-height: 1.7; }
  @media (min-width: 768px) { .legal-body-card { padding: 3rem; } }

  .legal-h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary, #E8EDFB);
    margin: 2rem 0 0.75rem;
  }
  .legal-h2:first-child { margin-top: 0; }
  .legal-h2-sm {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-primary, #E8EDFB);
    margin: 0 0 1rem;
  }
  .legal-body {
    color: var(--text-secondary, #8BA3C4);
    margin: 0 0 0.75rem;
    font-size: 1rem;
  }
  .legal-body:last-child { margin-bottom: 0; }
  .legal-list {
    color: var(--text-secondary, #8BA3C4);
    margin: 0.5rem 0 0.75rem 1.25rem;
    padding: 0;
    font-size: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .legal-link {
    color: var(--accent-blue, #4A9FE0);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 140ms;
  }
  .legal-link:hover { color: #79bfef; }

  .legal-nav-section { margin-top: 1.5rem; padding: 1.5rem; }
  @media (min-width: 768px) { .legal-nav-section { padding: 2rem; } }

  .legal-grid-3 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 768px) { .legal-grid-3 { grid-template-columns: repeat(3, 1fr); } }

  .legal-card__title {
    font-weight: 700;
    color: var(--text-primary, #E8EDFB);
    margin: 0 0 0.5rem;
  }
  .legal-card__body {
    font-size: 0.875rem;
    color: var(--text-primary, #E8EDFB);
    margin: 0;
    line-height: 1.55;
  }
</style>
