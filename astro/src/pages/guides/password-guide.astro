---
const target = "/guides/password-security-guide.html";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Redirecting…</title>
  <link rel="canonical" href={`https://toolbite.org${target}`} />
  <meta http-equiv="refresh" content={`0; url=${target}`} />
  <meta name="robots" content="noindex" />
  <script is:inline define:vars={{ target }}>window.location.replace(target);</script>
</head>
<body>
  <p>Redirecting to <a href={target}>Password Security Guide</a>…</p>
</body>
</html>
