---
import GuideLayout from "@/layouts/GuideLayout.astro";
import { SITE_URL } from "@/lib/seo";
import { buildBreadcrumbSchema, buildArticleSchema } from "@/lib/schema";

const title = "Password Security Essentials — Complete Guide | ToolBite";
const description = "Learn what makes a strong password, why password managers matter, how MFA works, and common mistakes to avoid. Practical guide with examples on ToolBite.";
const canonicalPath = "/guides/password-security-guide.html";
const pageUrl = `${SITE_URL}${canonicalPath}`;
const schemas = [
  buildArticleSchema({ title, description, url: pageUrl }),
  buildBreadcrumbSchema([
    { name: "Home", url: SITE_URL },
    { name: "Guides", url: `${SITE_URL}/guides.html` },
    { name: "Password security guide", url: pageUrl }
  ])
];

const mainHtml = String.raw`<div class="guide-page-root">
    <nav class="tb-breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li><li>›</li>
        <li><a href="/guides.html">Guides</a></li><li>›</li>
        <li class="breadcrumb-current">Password security essentials</li>
      </ol>
    </nav>

    <article class="tb-card tb-card-pad-lg">
      <h1 class="guide-h1">Password security essentials — what actually keeps accounts safe</h1>

      <p class="guide-lead">Most account breaches don't happen because of sophisticated hacking — they happen because of weak, reused, or leaked passwords. This guide covers what actually matters: length, uniqueness, storage, and multi-factor authentication.</p>

      <div class="guide-best-for guide-note-mt">
        <strong>Best for:</strong> anyone who wants to understand what makes a password secure and how to manage passwords without memorizing them all.
      </div>

      <h2>What makes a password strong?</h2>
      <p>Two factors matter more than anything else:</p>
      <ul>
        <li><strong>Length</strong> — a 20-character password is exponentially harder to crack than a 10-character one, even if the shorter one uses symbols.</li>
        <li><strong>Uniqueness</strong> — using the same password across multiple sites means one breach exposes all your accounts.</li>
      </ul>
      <p>Complexity rules (must include a symbol, a number, an uppercase letter) are less important than length. A random 16-character password like <code>kP9#mQxL2nRvTw8j</code> is strong. So is a long passphrase like <code>correct-horse-battery-staple</code>. Both are far better than <code>P@ssw0rd1</code>.</p>

      <h2>Why you should never reuse passwords</h2>
      <p>When a website gets breached, attackers take the leaked email/password pairs and try them on other sites — this is called <strong>credential stuffing</strong>. If you reuse your Gmail password on a small forum that gets hacked, your Gmail is now at risk.</p>
      <p>The only practical solution is a unique password for every account. That's impossible to memorize, which is exactly why password managers exist.</p>

      <h2>Password managers — the right solution</h2>
      <p>A password manager generates and stores a unique strong password for every site. You only need to remember one master password. Popular options:</p>
      <ul>
        <li><strong>Bitwarden</strong> — free, open-source, works on all platforms</li>
        <li><strong>1Password</strong> — polished, great for teams and families</li>
        <li><strong>KeePassXC</strong> — fully offline, stores everything locally</li>
      </ul>
      <p>Browser-built-in password managers (Chrome, Safari, Firefox) also work and are better than nothing — but they don't sync across all devices and apps as smoothly as dedicated tools.</p>

      <h2>Multi-factor authentication (MFA)</h2>
      <p>MFA adds a second step after your password — usually a 6-digit code from an app or a physical key. Even if your password is leaked, the attacker can't log in without the second factor.</p>
      <p>MFA types, from weakest to strongest:</p>
      <ul>
        <li><strong>SMS codes</strong> — better than nothing, but vulnerable to SIM-swap attacks</li>
        <li><strong>Authenticator apps</strong> (Google Authenticator, Authy, Raivo) — much better</li>
        <li><strong>Hardware keys</strong> (YubiKey) — the strongest option for high-value accounts</li>
        <li><strong>Passkeys</strong> — the new standard, phishing-resistant, no password at all</li>
      </ul>
      <p>Enable MFA on every account that supports it, especially email, banking, and cloud storage.</p>

      <h2>Common mistakes to avoid</h2>
      <ul>
        <li><strong>Short passwords with forced complexity</strong> — <code>P@ss1</code> is weaker than <code>correcthorsebatterystaple</code></li>
        <li><strong>Storing passwords in a text file or spreadsheet</strong> — use a password manager instead</li>
        <li><strong>Sharing passwords over email or Slack</strong> — use a secure sharing tool like Bitwarden Send</li>
        <li><strong>Using personal info</strong> — names, birthdays, and pet names are guessed first in targeted attacks</li>
        <li><strong>Rotating passwords on a fixed schedule</strong> — NIST no longer recommends this; change passwords only when there's a reason (breach, shared access revoked)</li>
      </ul>

      <h2>How to check if your password was leaked</h2>
      <p>Visit <a href="https://haveibeenpwned.com" target="_blank" rel="noopener noreferrer" class="guide-link">haveibeenpwned.com</a> and enter your email address. It checks against billions of leaked records. If your email appears in a breach, change that password immediately — especially if you reused it elsewhere.</p>

      <h2>Generating a strong password with ToolBite</h2>
      <ol>
        <li>Open <a href="/tools/password-generator.html">ToolBite's Password Generator</a>.</li>
        <li>Set length to at least 16 characters (20+ for critical accounts).</li>
        <li>Keep all options checked: uppercase, lowercase, numbers, symbols.</li>
        <li>Click <strong>Generate</strong> — the password is created on your device, never sent anywhere.</li>
        <li>Copy and paste it directly into your password manager.</li>
      </ol>

      <h2>Quick reference</h2>
      <ul>
        <li>Minimum 16 characters for any important account</li>
        <li>Unique password for every site — no exceptions</li>
        <li>Use a password manager — it solves the memory problem</li>
        <li>Enable MFA everywhere it's available</li>
        <li>Check haveibeenpwned.com after any major breach you hear about</li>
      </ul>

      <div class="guide-cta-row">
        <a href="/tools/password-generator.html" class="tb-btn tb-btn-outline guide-cta-link">Open Password Generator</a>
        <a href="/guides/hash-functions-explained.html" class="tb-btn tb-btn-outline guide-cta-link">Hash functions guide</a>
      </div>
    </article>

    <section class="tb-card tb-card-panel tb-card-pad-lg guide-mt">
      <h2 class="guide-section-title">Continue with related resources</h2>
      <div class="guide-grid-3">
        <a href="/tools/password-generator.html" class="tb-card tb-card-interactive tb-card-soft tb-card-pad-sm">
          <p class="guide-card-title">Password Generator</p>
          <p class="guide-card-desc">Generate a strong random password in one click.</p>
        </a>
        <a href="/guides/hash-functions-explained.html" class="tb-card tb-card-soft tb-card-pad-sm">
          <p class="guide-card-title">Hash Functions Explained</p>
          <p class="guide-card-desc">Understand how passwords are stored securely with hashing.</p>
        </a>
        <a href="/tools/uuid-generator.html" class="tb-card tb-card-interactive tb-card-soft tb-card-pad-sm">
          <p class="guide-card-title">UUID Generator</p>
          <p class="guide-card-desc">Generate unique tokens and identifiers for your apps.</p>
        </a>
      </div>
    </section>

    <section class="tb-card tb-card-panel tb-card-pad-lg guide-mt" aria-label="Tools used in this guide">
      <h2 class="guide-section-title">Tools used in this guide</h2>
      <div class="guide-tools-row">
        <a href="/tools/password-generator.html" class="tb-card tb-card-interactive tb-btn tb-btn-outline"><span aria-hidden="true">🔑</span><span>Password Generator</span></a>
        <a href="/tools/hash-generator.html" class="tb-card tb-card-interactive tb-btn tb-btn-outline"><span aria-hidden="true">🔢</span><span>Hash Generator</span></a>
      </div>
    </section>
</div>`;
---

<GuideLayout title={title} description={description} canonicalPath={canonicalPath} schemas={schemas}>
  <Fragment set:html={mainHtml} />
</GuideLayout>
