---
import ToolInterfaceWrapper from "@/components/tools/ToolInterfaceWrapper.astro";
import { getToolPageContent } from "@/data/tool-pages";
import ToolPageLayout from "@/layouts/ToolPageLayout.astro";

const content = getToolPageContent("read-time-calculator");
---

<ToolPageLayout
  slug="read-time-calculator"
  content={content}
  toolScript="/assets/js/tools/read-time-calculator.js"
>
  <ToolInterfaceWrapper title="Estimate reading time" privacyNote="Word counting and timing run on-device.">
    <label for="read-input" class="tool-label">Text</label>
    <textarea id="read-input" class="tb-textarea w-full h-56 mb-4"></textarea>
    <div class="mb-4">
      <label for="read-wpm" class="tool-label">Words per minute</label>
      <input id="read-wpm" type="number" min="1" max="400" value="200" class="tb-input" />
    </div>
    <div class="tool-stats-grid tool-stats-grid--3">
      <div class="tb-card tb-card-pad-md text-center"><span id="read-words" class="stat-value stat-value--sm">0</span><p class="stat-label">Words</p></div>
      <div class="tb-card tb-card-pad-md text-center"><span id="read-min" class="stat-value stat-value--sm">0</span><p class="stat-label">Minutes</p></div>
      <div class="tb-card tb-card-pad-md text-center"><span id="read-sec" class="stat-value stat-value--sm">0</span><p class="stat-label">Seconds</p></div>
    </div>
    <p id="read-summary" class="tool-hint"></p>
    <button id="read-clear-btn" class="tb-btn tb-btn-outline">Clear</button>
  </ToolInterfaceWrapper>
</ToolPageLayout>
