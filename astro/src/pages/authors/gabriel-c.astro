---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { createMetadata } from "@/lib/seo";

const title = "Gabriel C. — ToolBite Author & Technical Writer";
const description =
  "Meet Gabriel C., indie developer behind ToolBite: practical browser tools, reviewed guides, and privacy-first workflows for developers and writers on ToolBite.";
const canonicalPath = "/authors/gabriel-c.html";
const metadata = createMetadata({
  title,
  description,
  canonicalPath,
  keywords: ["Gabriel C.", "ToolBite author", "technical writer", "ToolBite guides", "indie developer"]
});
const mainHtml = String.raw`<div class="author-page-root">
    <h1 class="author-h1">Gabriel C.</h1>
    <p class="author-role">Developer &amp; Technical Writer</p>
    <p class="author-bio">Gabriel C. is an indie developer based in Bucharest, Romania, and built ToolBite as a free resource for developers and content creators.</p>

    <section class="tb-card">
      <h2 class="author-section-title">Guides by Gabriel C.</h2>
      <div class="author-guides-grid" id="author-guides-list"></div>
    </section>
  </div>`;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} rootPath="/" metadata={metadata}>
  <Fragment set:html={mainHtml} />
</BaseLayout>
