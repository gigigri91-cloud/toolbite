---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE_URL, createMetadata } from "@/lib/seo";
import { buildBreadcrumbSchema } from "@/lib/schema";

const title = "ToolBite Authors — Guides & Technical Writers | ToolBite";
const description =
  "Discover who writes ToolBite guides and tool pages: editorial standards, expertise, and how to follow authors behind tutorials. Read more on ToolBite today.";
const canonicalPath = "/authors/index.html";
const metadata = createMetadata({
  title,
  description,
  canonicalPath,
  keywords: ["ToolBite authors", "technical writers", "guide authors", "ToolBite team", "Gabriel C."]
});
const pageUrl = `${SITE_URL}${canonicalPath}`;
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "ToolBite authors",
    url: pageUrl,
    description: "Meet the authors behind ToolBite guides and tools."
  },
  buildBreadcrumbSchema([
    { name: "Home", url: SITE_URL },
    { name: "Authors", url: pageUrl }
  ])
];
const mainHtml = String.raw`<div class="authors-index-root">
    <h1 class="author-h1">Authors</h1>
    <div class="authors-grid">
      <a href="../gabriel-c.html" class="tb-card tb-card-interactive author-card">
        <div class="author-card__top">
          <div class="author-avatar">GC</div>
          <div>
            <h2 class="author-card__name">Gabriel C.</h2>
            <p class="author-card__role">Developer &amp; Technical Writer</p>
          </div>
        </div>
        <p class="author-card__bio">Indie developer in Bucharest, Romania. Builds ToolBite as a free, practical resource for developers and content creators.</p>
      </a>
    </div>
  </div>`;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} rootPath="/" metadata={metadata} schemas={schemas}>
  <Fragment set:html={mainHtml} />
</BaseLayout>
