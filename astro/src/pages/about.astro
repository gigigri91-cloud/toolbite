---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { createMetadata } from "@/lib/seo";
import { buildOrganizationSchema } from "@/lib/schema";

const title = "About ToolBite — Free Online Tools Built for Speed & Privacy";
const description =
  "Learn about ToolBite — a growing collection of free browser-based tools built for developers, writers, and designers. No accounts. No data collection. Try ToolBite.";
const canonicalPath = "/about.html";
const metadata = createMetadata({
  title,
  description,
  canonicalPath,
  keywords: ["ToolBite", "about ToolBite", "free online tools", "privacy-first tools", "browser utilities"]
});
const schemas = [buildOrganizationSchema()];
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} rootPath="/" metadata={metadata} schemas={schemas}>
  <div class="static-page-shell">
    <div class="static-page-hero">
      <nav class="tb-breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/">Home</a></li>
          <li>›</li>
          <li class="breadcrumb-current">About Us</li>
        </ol>
      </nav>

      <div class="about-hero">
        <h1 data-pseo-target="h1">About <span class="about-hero__accent">ToolBite</span></h1>
        <p class="about-hero__sub">ToolBite.org publishes free web utilities for developers, digital professionals, SEO experts, and writers. Our privacy-first architecture keeps routine tool processing in your browser: inputs are not uploaded to ToolBite for storage or later retrieval.</p>
      </div>
    </div>

    <div class="static-page-cards">
      <div class="tb-card tb-card-tool about-mission">
        <div class="mission-emoji">🚀</div>
        <h2 class="about-h2">Our Mission</h2>
        <p class="about-lead">
          <strong>Our mission is straightforward:</strong> provide fast, secure, and accessible web tools for everyone—whether you are shipping code, publishing content, or auditing SEO—without unnecessary friction, paywalls for basic utilities, or opaque data practices.
        </p>
        <p class="about-lead">
          We build for students, independent creators, engineers, marketers, SEO specialists, and teams who need dependable helpers for text cleanup, structured data checks, encoding, lightweight image optimization, and similar tasks. ToolBite is designed to stay readable, predictable, and quick to load so you can move from problem to result in seconds.
        </p>
        <div class="mission-grid">
          <div class="tb-card tb-card-accent">
            <h3 class="mission-card__title">⚡ Fast by design</h3>
            <p class="mission-card__body">Static pages and client-side processing keep interactions responsive. Where applicable, modern browser APIs help you complete cryptographic and formatting tasks without round-trips to an application server for the tool logic itself.</p>
          </div>
          <div class="tb-card tb-card-interactive">
            <h3 class="mission-card__title">🛡️ Secure defaults</h3>
            <p class="mission-card__body">We prioritize clear boundaries: your drafts, tokens, payloads, and files should remain under your control during routine tool use. When a workflow is browser-local, we say so plainly so you can choose the right tool for sensitive material.</p>
          </div>
          <div class="tb-card tb-card-interactive">
            <h3 class="mission-card__title">♿ Accessible utilities</h3>
            <p class="mission-card__body">Accessibility matters for "tools for everyone." We aim for legible typography, sensible contrast, keyboard-friendly layouts where possible, and descriptive labeling so professionals can work quickly without hunting for hidden controls.</p>
          </div>
        </div>
      </div>

      <section class="tb-card tb-card-panel tb-card-pad-lg about-section" aria-labelledby="privacy-approach-heading">
        <h2 id="privacy-approach-heading" class="about-h2">Privacy-First Approach</h2>
        <p class="about-body">
          ToolBite's utilities are built around <strong>client-side execution</strong>: in normal use, the tool logic runs in your web browser on your device using JavaScript, rather than sending your pasted text, decoded tokens, generated passwords, or uploaded files to ToolBite for centralized processing.
        </p>
        <p class="about-body">
          <strong>Your routine tool inputs are never uploaded to our servers for storage.</strong> We do not operate a ToolBite account database of what you paste into calculators, formatters, encoders, or similar helpers, and we do not retain that content on our systems as part of delivering those features.
        </p>
        <p class="about-body">
          You should still treat highly sensitive secrets carefully (for example, never share private keys), and you should review third-party services that may load on pages (such as advertising or analytics) separately. For the full legal detail on cookies, ads, logging, and exceptions, read our <a href="privacy.html" class="about-link">Privacy Policy</a> and <a href="cookie-policy.html" class="about-link">Cookie Policy</a>
          <button type="button" data-open-cookie-settings="true" class="cookie-settings-btn">Cookie Settings</button>.
        </p>
      </section>

      <section class="tb-card tb-card-panel tb-card-pad-lg about-section" aria-labelledby="publisher-heading">
        <h2 id="publisher-heading" class="about-h2">The Publisher</h2>
        <p class="about-body">
          <strong>ToolBite</strong> (published at <a href="https://toolbite.org/" class="about-link">toolbite.org</a>) is a <strong>dedicated, reliable resource</strong> for developers, digital professionals, and <strong>SEO experts</strong> who need consistent, browser-based utilities alongside practical, citation-friendly guides.
        </p>
        <p class="about-body">
          The site is organized as a catalog of focused tools (text, developer, image, and SEO categories) and short tutorials that explain safe workflows—so citations can point to a single publisher name (ToolBite), a stable domain (toolbite.org), and specific tool pages with consistent metadata.
        </p>
        <p class="about-body">
          If you are verifying ownership, authorship, or editorial responsibility for citations: ToolBite publishes this website as a cohesive utility collection; contact and policy pages describe how to reach the operator and what limitations apply.
        </p>
      </section>

      <section class="tb-card about-explore-section">
        <h2 class="about-h2-sm">Explore ToolBite</h2>
        <div class="about-grid-3">
          <a href="/categories/text-tools.html" class="tb-card tb-card-soft tb-card-pad-sm">
            <h3 class="about-card__title">Text Tools</h3>
            <p class="about-card__body">Word count, case conversion, slug creation, cleanup, and editing helpers.</p>
          </a>
          <a href="/categories/developer-tools.html" class="tb-card tb-card-soft tb-card-pad-sm">
            <h3 class="about-card__title">Developer Tools</h3>
            <p class="about-card__body">JSON, JWT, Base64, hashing, UUIDs, and fast browser-based debugging utilities.</p>
          </a>
          <a href="/guides/" class="tb-card tb-card-soft tb-card-pad-sm">
            <h3 class="about-card__title">Guides &amp; Tutorials</h3>
            <p class="about-card__body">Short practical walkthroughs for JSON, JWT, SEO slugs, and related workflows.</p>
          </a>
        </div>
      </section>

      <section class="tb-card about-explore-section" aria-labelledby="related-resources-heading">
        <h2 id="related-resources-heading" class="about-h2-sm">Related Resources</h2>
        <p class="about-sub-text">Hand-picked tool and guide pages that pair well with ToolBite's developer-focused workflow.</p>
        <div class="about-grid-2">
          <a href="/tools/jwt-decoder.html" class="tb-card tb-card-interactive about-resource-card">
            <span class="resource-badge resource-badge--tool">Tool</span>
            <h3 class="about-resource__title">JWT Decoder</h3>
            <p class="about-card__body">Inspect JWT headers and payloads in your browser for debugging—without uploading tokens for signature verification.</p>
            <span class="resource-cta resource-cta--tool">Open tool →</span>
          </a>
          <a href="/guides/json-formatter-guide.html" class="tb-card tb-card-interactive about-resource-card">
            <span class="resource-badge resource-badge--guide">Guide</span>
            <h3 class="about-resource__title">JSON Formatter Guide</h3>
            <p class="about-card__body">Fix common JSON errors, choose minify vs beautify, and format payloads safely using browser-local workflows.</p>
            <span class="resource-cta resource-cta--guide">Read guide →</span>
          </a>
        </div>
      </section>

      <section class="tb-card tb-card-panel tb-card-pad-lg about-section" aria-labelledby="who-we-are-heading">
        <h2 id="who-we-are-heading" class="about-h2">Who We Are</h2>
        <p class="about-body">ToolBite is operated by <strong>Gabriel C.</strong>, an indie developer based in Bucharest, Romania. This is a solo project focused on practical browser-based tools and concise technical guides.</p>
      </section>

      <section class="tb-card tb-card-panel tb-card-pad-lg about-section" aria-labelledby="editorial-standards-heading">
        <h2 id="editorial-standards-heading" class="about-h2">Editorial Standards</h2>
        <p class="about-body">Tool pages are tested manually before release, and guides are reviewed before publication. We do not publish AI-only, unreviewed content.</p>
      </section>

      <section class="tb-card tb-card-panel tb-card-pad-lg about-section" aria-labelledby="contact-response-heading">
        <h2 id="contact-response-heading" class="about-h2">Contact &amp; Response Time</h2>
        <p class="about-body">For bugs, corrections, or partnership requests, use the <a href="contact.html" class="about-link">contact page</a>. Typical response time is <strong>24–48 hours</strong>.</p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* Breadcrumb */
  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    font-size: 0.875rem;
    color: var(--text-muted, #7A8BAD);
  }
  .breadcrumb-list a { color: var(--text-muted, #7A8BAD); text-decoration: none; transition: color 140ms; }
  .breadcrumb-list a:hover { color: var(--accent-blue, #4A9FE0); }
  .breadcrumb-current { color: var(--text-secondary, #8BA3C4); font-weight: 500; }

  /* Hero */
  .about-hero { margin-bottom: 2rem; }
  .about-hero h1 {
    font-size: clamp(2rem, 4vw + 1rem, 3rem);
    font-weight: 800;
    color: var(--text-primary, #E8EDFB);
    margin: 0 0 1rem;
    line-height: 1.1;
  }
  .about-hero__accent { color: var(--accent-blue, #4A9FE0); }
  .about-hero__sub {
    font-size: 1.125rem;
    color: var(--text-secondary, #8BA3C4);
    max-width: 60ch;
    line-height: 1.6;
    margin: 0;
  }

  /* Mission card */
  .about-mission { position: relative; overflow: hidden; }
  .mission-emoji { font-size: 3.5rem; margin-bottom: 1.25rem; }
  .about-h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary, #E8EDFB);
    margin: 0 0 1.25rem;
  }
  .about-h2-sm {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary, #E8EDFB);
    margin: 0 0 1rem;
  }
  .about-lead {
    font-size: 1.0625rem;
    color: var(--text-primary, #E8EDFB);
    line-height: 1.65;
    margin: 0 0 1.25rem;
    max-width: 66ch;
  }
  .mission-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 768px) {
    .mission-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .mission-card__title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent-blue, #4A9FE0);
    margin: 0 0 0.5rem;
  }
  .mission-card__body {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-primary, #E8EDFB);
    margin: 0;
  }

  /* Section layout */
  .about-section { margin-top: 1.5rem; }
  .about-body {
    font-size: 1.0625rem;
    color: var(--text-primary, #E8EDFB);
    line-height: 1.65;
    margin: 0 0 1rem;
  }
  .about-body:last-child { margin-bottom: 0; }
  .about-link {
    color: var(--accent-blue, #4A9FE0);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 140ms;
  }
  .about-link:hover { color: #79bfef; }

  .cookie-settings-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted, #7A8BAD);
    font-size: inherit;
    padding: 0;
    transition: color 140ms;
  }
  .cookie-settings-btn:hover { color: var(--accent-blue, #4A9FE0); }

  /* Explore + Related sections */
  .about-explore-section { margin-top: 1.5rem; padding: 1.5rem; }
  @media (min-width: 768px) { .about-explore-section { padding: 2rem; } }

  .about-sub-text {
    font-size: 0.875rem;
    color: var(--text-secondary, #8BA3C4);
    margin: 0 0 1.25rem;
    max-width: 56ch;
  }
  .about-grid-3 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 768px) { .about-grid-3 { grid-template-columns: repeat(3, 1fr); } }

  .about-grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) { .about-grid-2 { grid-template-columns: repeat(2, 1fr); } }

  .about-card__title {
    font-weight: 700;
    color: var(--text-primary, #E8EDFB);
    margin: 0 0 0.5rem;
  }
  .about-card__body {
    font-size: 0.875rem;
    color: var(--text-primary, #E8EDFB);
    margin: 0;
    line-height: 1.55;
  }

  /* Resource cards */
  .about-resource-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    text-decoration: none;
  }
  .resource-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }
  .resource-badge--tool { color: var(--accent-blue, #4A9FE0); }
  .resource-badge--guide { color: var(--accent-orange, #f5a623); }

  .about-resource__title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary, #E8EDFB);
    margin: 0 0 0.5rem;
    transition: color 140ms;
  }
  .about-resource-card:hover .about-resource__title { color: var(--accent-blue, #4A9FE0); }
  .about-resource-card:has(.resource-badge--guide):hover .about-resource__title { color: var(--accent-orange, #f5a623); }

  .resource-cta {
    display: block;
    margin-top: 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    transition: color 140ms;
  }
  .resource-cta--tool { color: var(--accent-blue, #4A9FE0); }
  .resource-cta--guide { color: var(--accent-orange, #f5a623); }
</style>
