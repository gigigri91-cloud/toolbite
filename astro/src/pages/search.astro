---
import SearchEmptyState from "@/components/search/SearchEmptyState.astro";
import SearchInput from "@/components/search/SearchInput.astro";
import SearchOverlay from "@/components/search/SearchOverlay.astro";
import SearchResultCard from "@/components/search/SearchResultCard.astro";
import SearchResults from "@/components/search/SearchResults.astro";
import SearchSuggestions from "@/components/search/SearchSuggestions.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { createMetadata } from "@/lib/seo";
import { getAllTools, getPopularTools } from "@/lib/tools";

const toolsTotal = getAllTools().filter(t => t.url.startsWith('tools/')).length;
const title = "Search ToolBite Tools & Guides Online — Free Discovery | ToolBite";
const description =
  "Search ToolBite tools and guides instantly: JSON, JWT, text, SEO, and image utilities with keyboard-first results. Find the right workflow on ToolBite today.";
const canonicalPath = "/search.html";
const metadata = createMetadata({
  title,
  description,
  canonicalPath,
  robots: { index: false, follow: true },
  keywords: ["tool search", "toolbite search", "find tools", "productivity"]
});
const quickPicks = getPopularTools(6);
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} metadata={metadata}>
  <section class="tb-card tb-card-panel tb-card-pad-lg search-shell">
    <header class="search-header">
      <h1 class="search-page-title">Find the right tool, instantly</h1>
      <p class="search-page-sub">Keyboard-first discovery for tools, guides, and workflows.</p>
    </header>

    <div class="search-toolbar">
      <SearchInput />
      <label for="search-category-filter" class="sr-only">Filter by category</label>
      <select id="search-category-filter" class="tb-input">
        <option value="all">All categories</option>
        <option value="text-tools">Text tools</option>
        <option value="developer-tools">Developer tools</option>
        <option value="image-tools">Image tools</option>
        <option value="seo-tools">SEO tools</option>
        <option value="guides">Guides</option>
      </select>
    </div>

    <SearchSuggestions />
    <SearchResults />
    <SearchEmptyState />
    <SearchResultCard />
  </section>

  <section class="tb-card tb-card-panel tb-card-pad-lg search-quickpicks">
    <h2 class="search-section-title">Quick picks</h2>
    <div class="quickpicks-grid">
      {quickPicks.map((tool) => (
        <a href={`/${tool.url}`} class="tb-card tb-card-interactive tb-card-pad-md">
          <span class="mr-2">{tool.icon || "🧰"}</span>{tool.title}
        </a>
      ))}
    </div>
  </section>

  <section class="search-help tb-card tb-card-panel tb-card-pad-lg">
    <h2 class="search-section-title">Search tips</h2>
    <p class="search-help-text">
      Search across all {toolsTotal} ToolBite tools, guides, and categories. Type the name of a tool, a task (like "encode" or "format"), or a file type (like "JSON" or "CSV") to find relevant tools and guides. Results update as you type.
    </p>
    <p class="search-help-text">
      If you are looking for a specific type of tool, try browsing by category: Developer Tools, Text Tools, Image Tools, or SEO Tools. Categories group tools by the type of work they support.
    </p>
  </section>

  <SearchOverlay>
    <p class="search-overlay-hint">Use <kbd>Ctrl/Cmd + K</kbd> to focus search, arrows to navigate, Enter to open result.</p>
    <SearchSuggestions />
  </SearchOverlay>

  <Fragment slot="scripts">
    <script defer src="/assets/js/search.js"></script>
  </Fragment>
</BaseLayout>

<style>
  .search-shell {
    background:
      radial-gradient(90% 120% at 90% -20%, rgba(74, 159, 224, 0.15), transparent 60%),
      var(--bg-secondary, #0d1521);
  }
  .search-header { margin-bottom: 1rem; }
  .search-page-title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
    color: var(--text-primary, #E8EDFB);
    margin: 0 0 0.35rem;
  }
  .search-page-sub {
    font-size: 0.875rem;
    color: var(--text-secondary, #8BA3C4);
    margin: 0;
  }
  .search-toolbar { display: grid; grid-template-columns: 1fr; gap: 0.75rem; }
  @media (min-width: 768px) {
    .search-toolbar { grid-template-columns: minmax(0, 1fr) 220px; }
  }
  .search-quickpicks, .search-help { margin-top: 1.5rem; }
  .search-section-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary, #E8EDFB);
    margin: 0 0 0.75rem;
  }
  .quickpicks-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .quickpicks-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .quickpicks-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .search-help-text {
    color: var(--text-secondary, #8BA3C4);
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }
  .search-help-text:last-child { margin-bottom: 0; }
  .search-overlay-hint {
    font-size: 0.875rem;
    color: var(--text-muted, #7A8BAD);
    margin-bottom: 0.5rem;
  }
</style>
