---
import CategoryHighlights from "@/components/discovery/CategoryHighlights.astro";
import PopularToolsSection from "@/components/discovery/PopularToolsSection.astro";
import RecentlyAddedSection from "@/components/discovery/RecentlyAddedSection.astro";
import RecommendedToolsSection from "@/components/discovery/RecommendedToolsSection.astro";
import TrendingToolsSection from "@/components/discovery/TrendingToolsSection.astro";
import ToolCard from "@/components/discovery/ToolCard.astro";
import SearchInput from "@/components/search/SearchInput.astro";
import SearchOverlay from "@/components/search/SearchOverlay.astro";
import SearchSuggestions from "@/components/search/SearchSuggestions.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { HOMEPAGE_TITLE, createMetadata } from "@/lib/seo";
import { buildOrganizationSchema, buildWebSiteSchema } from "@/lib/schema";
import { getAllTools, getCategoryTools, getPopularTools } from "@/lib/tools";

const toolsTotal = getAllTools().filter(t => t.url.startsWith('tools/')).length;
const allItemsTotal = getAllTools().length;
const title = HOMEPAGE_TITLE;
const description =
  `${toolsTotal} free browser-based tools for JSON formatting, passwords, image compression, and text editing. No account, no upload—100% client-side. Start on ToolBite.`;
const canonicalPath = "/";
const metadata = createMetadata({
  title,
  description,
  canonicalPath,
  keywords: ["ai productivity", "browser tools", "developer workflows", "seo workflows", "toolbite ecosystem"]
});

const schemas = [buildWebSiteSchema(), buildOrganizationSchema()];
const popularGridTools = getPopularTools(12);
const aiTools = getPopularTools(6).filter((tool) =>
  tool.keywords.some((k) => ["json", "slug", "read", "jwt", "text", "image"].includes(k.toLowerCase()))
);
const trustStats = [
  { label: "Browser-native workflows", value: "100%" },
  { label: "Categories powering discovery", value: "4+" },
  { label: "Tools and guides connected", value: `${allItemsTotal}+` },
  { label: "Server upload required", value: "0" }
];
const categoryFeatured = getCategoryTools("developer-tools").slice(0, 4);
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} metadata={metadata} schemas={schemas}>
  <section class="home-hero">
    <div class="hero-glow-blue" aria-hidden="true"></div>
    <div class="hero-glow-orange" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="terminal-tag">▶ {toolsTotal} free tools — no login required</div>
      <h1>Build faster workflows without leaving your browser.</h1>
      <p class="hero-copy">
        ToolBite turns isolated utilities into a connected discovery layer for writing, development, SEO, and media operations.
        Explore, chain, and reuse workflows in seconds.
      </p>
      <div class="hero-actions">
        <a href="/search.html" class="tb-btn tb-btn-primary cta-terminal"><span class="cta-dollar">$</span><span>explore_tools()</span></a>
        <a href="/categories/developer-tools.html" class="tb-btn tb-btn-secondary">Open workflow categories</a>
      </div>
      <SearchSuggestions />
    </div>
  </section>

  <div class="stats-bar tb-reveal">
    <div class="stat">
      <span class="stat-num blue">{toolsTotal}</span><span class="stat-label">free tools</span>
    </div>
    <div class="stat">
      <span class="stat-num orange">100%</span><span class="stat-label">client-side</span>
    </div>
    <div class="stat">
      <span class="stat-num purple">0</span><span class="stat-label">login needed</span>
    </div>
    <div class="stat">
      <span class="stat-num teal">∞</span><span class="stat-label">free forever</span>
    </div>
  </div>

  <section class="home-section tb-reveal home-popular-tools">
    <p class="home-popular-kicker">
      <span class="home-popular-kicker__accent">// popular tools</span>
      <span class="home-popular-kicker__meta"> [ {toolsTotal} total ]</span>
    </p>
    <div class="tools-grid">
      {popularGridTools.map((tool) => (
        <ToolCard tool={tool} />
      ))}
    </div>
  </section>

  <section class="why-section home-section tb-reveal" aria-labelledby="why-toolbite-heading">
    <div class="section-head">
      <h2 id="why-toolbite-heading">Why developers and writers use ToolBite</h2>
      <p>Built for privacy, speed, and real daily workflows — no strings attached.</p>
    </div>
    <div class="why-grid">
      <article class="tb-card tb-card-interactive tb-card-pad-lg why-card-new">
        <span class="why-icon" aria-hidden="true">🔒</span>
        <h3>100% client-side processing</h3>
        <p>Every tool runs entirely in your browser. Your JSON, passwords, tokens, and text are never sent to a server, never logged, and never stored.</p>
      </article>
      <article class="tb-card tb-card-interactive tb-card-pad-lg why-card-new">
        <span class="why-icon" aria-hidden="true">⚡</span>
        <h3>No account required</h3>
        <p>All tools are free and accessible without registration — no trial period, no usage limit, no feature gating. Open and start working immediately.</p>
      </article>
      <article class="tb-card tb-card-interactive tb-card-pad-lg why-card-new">
        <span class="why-icon" aria-hidden="true">🔗</span>
        <h3>Built for real workflows</h3>
        <p>Focused interfaces for development, writing, SEO, and design. Contextual links turn isolated tasks into repeatable multi-step workflows.</p>
      </article>
      <article class="tb-card tb-card-interactive tb-card-pad-lg why-card-new">
        <span class="why-icon" aria-hidden="true">🔍</span>
        <h3>Search-first exploration</h3>
        <p>Command-style discovery with <kbd>Ctrl/⌘K</kbd> helps you move from intent to action in seconds.</p>
      </article>
      <article class="tb-card tb-card-interactive tb-card-pad-lg why-card-new">
        <span class="why-icon" aria-hidden="true">🌐</span>
        <h3>Connected ecosystem</h3>
        <p>Cross-linked tools and guides create a discovery layer that grows with your knowledge, not just your bookmark list.</p>
      </article>
      <article class="tb-card tb-card-interactive tb-card-pad-lg why-card-new">
        <span class="why-icon" aria-hidden="true">♾️</span>
        <h3>Free forever by design</h3>
        <p>No freemium gates, no premium tiers. The full toolset is available to everyone, every time.</p>
      </article>
    </div>
  </section>

  <section class="home-section tb-reveal">
    <div class="section-head">
      <h2>Smart search command center</h2>
      <p>Instant discovery with keyboard-first navigation and contextual suggestions.</p>
    </div>
    <div class="search-command-card tb-card tb-card-panel tb-card-pad-lg">
      <div class="command-grid">
        <div>
          <p class="command-title">Quick-open style navigation</p>
          <p class="command-copy">Press <kbd>Ctrl/⌘K</kbd> or <kbd>/</kbd> to jump into command-style search from anywhere.</p>
        </div>
        <a href="/search.html" class="tb-btn tb-btn-secondary">Open full search</a>
      </div>
    </div>
  </section>

  <section class="home-section tb-reveal">
    <TrendingToolsSection />
  </section>

  <section class="home-section tb-reveal">
    <div class="section-head">
      <h2>AI tools for modern workflows</h2>
      <p>Prompt-ready utilities for structured output, content transformation, and optimization loops.</p>
    </div>
    <div class="ai-tools-grid">
      {aiTools.map((tool) => (
        <a href={`/${tool.url}`} class="tb-card tb-card-interactive tb-card-pad-lg ai-card">
          <p class="ai-label">AI workflow</p>
          <h3 class="ai-card__title">{tool.icon || "🧠"} {tool.title}</h3>
          <p class="ai-card__desc">{tool.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section tb-reveal">
    <CategoryHighlights
      categorySlug="developer-tools"
      categoryTitle="Popular categories"
      heroDescription="Explore curated category hubs with built-in cross-linking and workflow context."
      featuredTools={categoryFeatured}
    />
  </section>

  <section class="home-section tb-reveal">
    <RecentlyAddedSection />
  </section>

  <section class="home-section tb-reveal">
    <div class="section-head">
      <h2>Trust by architecture</h2>
      <p>Platform fundamentals designed for reliability and scale.</p>
    </div>
    <div class="stats-grid">
      {trustStats.map((item) => (
        <article class="tb-card tb-card-panel tb-card-pad-lg stat-card">
          <p class="stat-value">{item.value}</p>
          <p class="stat-label">{item.label}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="home-section tb-reveal">
    <RecommendedToolsSection />
  </section>

  <SearchOverlay>
    <SearchInput id="search-overlay-input" placeholder="Quick open tools and guides..." />
    <SearchSuggestions />
    <p class="search-esc-hint">Press <kbd>Esc</kbd> to close command search.</p>
  </SearchOverlay>

  <Fragment slot="scripts">
    <script defer src="/assets/js/search.js"></script>
  </Fragment>
</BaseLayout>

<style>
  .home-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0;
    margin-bottom: 1.5rem;
  }
  /* Accent vizual subtil între secțiuni — linie gradient */
  .home-section + .home-section {
    position: relative;
  }
  .home-section + .home-section::before {
    content: '';
    display: block;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(74,159,224,0.12), rgba(255,154,69,0.08), transparent);
    margin-bottom: 1.5rem;
  }
  .home-hero {
    position: relative;
    overflow: hidden;
    max-width: 1200px;
    margin: 1rem auto 0;
    padding: 0;
    padding-bottom: 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--border-subtle, var(--color-border-primary));
    background: var(--bg-secondary, var(--color-bg-secondary));
  }
  .hero-content {
    position: relative;
    z-index: 1;
    padding: clamp(1.25rem, 3vw, 2.5rem) clamp(1.25rem, 4vw, 2.5rem);
  }
  .hero-glow-blue {
    position: absolute;
    top: -80px;
    left: -100px;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(26, 95, 217, 0.15) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-glow-orange {
    position: absolute;
    top: -60px;
    right: -80px;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(245, 166, 35, 0.1) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .stats-bar {
    max-width: 1200px;
    margin-top: 0;
    margin: 0 auto 1.5rem;
    padding: 1rem 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    align-items: center;
    gap: 0.75rem 1rem;
    border-top: 1px solid var(--border-subtle, var(--color-border-primary));
    border-bottom: 1px solid var(--border-subtle, var(--color-border-primary));
    background: transparent;
  }
  .stats-bar .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.25rem;
    min-width: 5.5rem;
  }
  .stats-bar .stat-num {
    font-size: 26px;
    font-weight: 900;
    font-family: var(--font-mono);
    line-height: 1.1;
  }
  .stats-bar .stat-num.blue {
    color: #4d9fff;
  }
  .stats-bar .stat-num.orange {
    color: #f5a623;
  }
  .stats-bar .stat-num.purple {
    color: #a855f7;
  }
  .stats-bar .stat-num.teal {
    color: #2dd4bf;
  }
  .stats-bar .stat-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted, #7A8BAD);
    font-weight: 600;
  }
  .home-popular-kicker {
    font-family: var(--font-mono);
    font-size: 13px;
    margin: 0 0 0.65rem;
    letter-spacing: 0.06em;
  }
  .home-popular-kicker__accent {
    color: var(--accent-orange, #FF9A45);
  }
  .home-popular-kicker__meta {
    color: var(--text-muted, #7A8BAD);
  }
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  @media (max-width: 960px) {
    .tools-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .tools-grid {
      grid-template-columns: 1fr;
    }
  }
  .hero-kicker {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 13px;
    font-weight: 700;
    color: var(--text-muted, #7A8BAD);
    margin-bottom: 0.75rem;
  }
  .terminal-tag {
    font-family: var(--font-mono);
    color: var(--color-brand-blue);
    background: var(--bg-secondary, #0d1e35);
    border: 1px solid var(--color-border-accent-blue);
    padding: 0.375rem 0.875rem;
    border-radius: 4px;
    display: inline-flex;
    margin-bottom: 0.8rem;
  }
  .home-hero h1 {
    margin: 0;
    font-size: clamp(2rem, 4.4vw, 3.6rem);
    line-height: 1.05;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }
  .hero-copy {
    margin-top: 0.9rem;
    max-width: 60ch;
    font-size: clamp(1rem, 1.8vw, 1.12rem);
    color: var(--color-text-secondary);
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1rem; }
  .cta-terminal { font-family: var(--font-mono); }
  .cta-dollar { color: var(--color-brand-orange); }
  .section-head h2 {
    margin: 0;
    font-size: clamp(1.3rem, 3vw, 2rem);
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }
  .section-head p { margin: 0.35rem 0 0.85rem; color: var(--color-text-secondary); }
  .ai-tools-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .ai-tools-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .ai-tools-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .ai-card { transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease; }
  .ai-card:hover { transform: translateY(-3px); border-color: var(--color-border-accent-blue); box-shadow: 0 12px 26px rgba(74, 159, 224, 0.22); }
  .ai-card__title { color: var(--text-primary, #E8EDFB); font-size: 1.125rem; font-weight: 700; margin: 0 0 0.35rem; }
  .ai-card__desc { color: var(--text-secondary, #8BA3C4); font-size: 0.875rem; margin: 0; line-height: 1.55; }
  .ai-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-brand-blue); margin-bottom: 0.4rem; }
  .search-esc-hint { font-size: 0.875rem; margin-top: 0.75rem; color: var(--text-muted, #7A8BAD); }
  .stats-grid { display: grid; gap: 0.85rem; grid-template-columns: repeat(1, minmax(0, 1fr)); }
  @media (min-width: 768px) {
    .stats-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .stat-value { margin: 0; font-size: 1.7rem; font-weight: 800; color: var(--color-brand-blue); }
  .stat-card .stat-label { margin: 0.25rem 0 0; color: var(--text-muted, #7A8BAD); font-size: 0.88rem; }
  .discovery-cta,
  .premium-footer {
    background:
      radial-gradient(100% 120% at 90% -20%, rgba(74, 159, 224, 0.18), transparent 62%),
      var(--color-bg-card);
  }
  .discovery-cta h2,
  .premium-footer h2 { margin: 0 0 0.35rem; color: var(--color-text-primary); }
  .discovery-cta p,
  .premium-footer p { margin: 0; color: var(--color-text-secondary); }
  .premium-links { margin-top: 0.85rem; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .premium-links a { color: var(--color-text-secondary); text-decoration: none; border-bottom: 1px solid transparent; }
  .premium-links a:hover { border-bottom-color: var(--color-brand-blue); color: var(--color-brand-blue); }
  .search-command-card .command-grid { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; align-items: center; }
  .command-title { margin: 0 0 0.25rem; font-weight: 700; color: var(--color-text-primary); }
  .command-copy { margin: 0; color: var(--color-text-secondary); }
  .search-command-card kbd { color: var(--color-brand-orange); background: var(--bg-secondary, #0d1e35); border: 1px solid var(--color-border-accent-orange); border-radius: 4px; padding: 0.05rem 0.35rem; font-family: var(--font-mono); }
  .why-section {
    padding: 1.5rem 0;
  }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
    margin-top: 0;
  }
  .why-card-new {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .why-icon {
    font-size: 1.4rem;
    line-height: 1;
    display: block;
    margin-bottom: 0.25rem;
  }
  .why-card-new h3 {
    color: var(--accent-blue, #4A9FE0);
    font-size: 1rem;
    font-weight: 700;
    margin: 0;
  }
  .why-card-new p {
    color: var(--text-secondary, #8BA3C4);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0;
  }
  .why-card-new kbd {
    color: var(--accent-orange, #FF9A45);
    background: rgba(255, 154, 69, 0.08);
    border: 1px solid rgba(255, 154, 69, 0.2);
    border-radius: 4px;
    padding: 0.05rem 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.8em;
  }
  @media (max-width: 900px) {
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .why-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ai-card { transition: none; }
    .ai-card:hover { transform: none; }
  }
</style>
