---
import CategoryHighlights from "@/components/discovery/CategoryHighlights.astro";
import RecentlyVisited from "@/components/discovery/RecentlyVisited.astro";
import ToolCard from "@/components/discovery/ToolCard.astro";
import SearchSuggestions from "@/components/search/SearchSuggestions.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { HOMEPAGE_TITLE, createMetadata } from "@/lib/seo";
import { buildOrganizationSchema, buildWebSiteSchema, buildFaqSchema } from "@/lib/schema";
import { getAllTools, getCategoryTools, getPopularTools } from "@/lib/tools";

const toolsTotal = getAllTools().filter(t => t.url.startsWith('tools/')).length;
const title = HOMEPAGE_TITLE;
const description =
  `${toolsTotal} free browser-based tools for JSON formatting, passwords, image compression, and text editing. No account, no upload—100% client-side. Start on ToolBite.`;
const canonicalPath = "/";
const metadata = createMetadata({
  title,
  description,
  canonicalPath,
  keywords: ["ai productivity", "browser tools", "developer workflows", "seo workflows", "toolbite ecosystem"]
});

const homepageFaq = [
  {
    question: "Are all ToolBite tools free to use?",
    answer: "Yes. Every tool on ToolBite is completely free with no account required, no usage limits, and no feature gating. The full toolset is available to everyone."
  },
  {
    question: "Do ToolBite tools store or upload my data?",
    answer: "No. All tools run entirely in your browser using JavaScript. Your text, files, tokens, and passwords are never sent to our servers or stored anywhere."
  },
  {
    question: "What types of tools does ToolBite offer?",
    answer: `ToolBite offers ${toolsTotal} browser-based tools across four categories: Developer Tools (JSON formatter, JWT decoder, Base64, UUID generator, hash generator), Text Tools (word counter, case converter, slug generator, lorem ipsum), Image Tools (image compressor, color palette generator), and SEO Tools (text-to-slug, read time calculator).`
  },
  {
    question: "How do I find a tool quickly on ToolBite?",
    answer: "Use the keyboard shortcut Ctrl+K (or Cmd+K on Mac) to open command-style search from any page. You can also browse by category or use the full search page at toolbite.org/search.html."
  }
];
const schemas = [buildWebSiteSchema(), buildOrganizationSchema(), buildFaqSchema(homepageFaq, "https://toolbite.org/")];
const popularGridTools = getPopularTools(12);
const categoryFeatured = getCategoryTools("developer-tools").slice(0, 4);
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} metadata={metadata} schemas={schemas}>
  <section class="home-hero">
    <div class="hero-glow-blue" aria-hidden="true"></div>
    <div class="hero-glow-orange" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="terminal-tag">▶ {toolsTotal} free tools — no login required</div>
      <h1>Build faster workflows without leaving your browser.</h1>
      <p class="hero-copy">
        ToolBite turns isolated utilities into a connected discovery layer for writing, development, SEO, and media operations.
        Explore, chain, and reuse workflows in seconds.
      </p>
      <div class="hero-actions">
        <a href="/search.html" class="tb-btn tb-btn-primary cta-terminal"><span class="cta-dollar">$</span><span>explore_tools()</span></a>
        <a href="/categories/developer-tools.html" class="tb-btn tb-btn-secondary">Open workflow categories</a>
      </div>
      <SearchSuggestions />
    </div>
  </section>

  <RecentlyVisited variant="bar" maxItems={5} />

  <div class="stats-bar tb-reveal">
    <div class="stat">
      <span class="stat-num blue">{toolsTotal}</span><span class="stat-label">free tools</span>
    </div>
    <div class="stat">
      <span class="stat-num orange">100%</span><span class="stat-label">client-side</span>
    </div>
    <div class="stat">
      <span class="stat-num purple">0</span><span class="stat-label">login needed</span>
    </div>
    <div class="stat">
      <span class="stat-num teal">∞</span><span class="stat-label">free forever</span>
    </div>
  </div>

  <section class="home-section tb-reveal home-popular-tools">
    <p class="home-popular-kicker">
      <span class="home-popular-kicker__accent">// popular tools</span>
      <span class="home-popular-kicker__meta"> [ {toolsTotal} total ]</span>
    </p>
    <div class="tools-grid">
      {popularGridTools.map((tool) => (
        <ToolCard tool={tool} />
      ))}
    </div>
  </section>

  <section class="why-section home-section tb-reveal" aria-labelledby="why-toolbite-heading">
    <div class="section-head">
      <h2 id="why-toolbite-heading">Why developers and writers use ToolBite</h2>
      <p>Built for privacy, speed, and real daily workflows — no strings attached.</p>
    </div>
    <div class="why-grid">
      <article class="tb-card tb-card-interactive tb-card-pad-lg why-card-new">
        <span class="why-icon" aria-hidden="true">🔒</span>
        <h3>100% client-side processing</h3>
        <p>Every tool runs entirely in your browser. Your JSON, passwords, tokens, and text are never sent to a server, never logged, and never stored.</p>
      </article>
      <article class="tb-card tb-card-interactive tb-card-pad-lg why-card-new">
        <span class="why-icon" aria-hidden="true">⚡</span>
        <h3>No account required</h3>
        <p>All tools are free and accessible without registration — no trial period, no usage limit, no feature gating. Open and start working immediately.</p>
      </article>
      <article class="tb-card tb-card-interactive tb-card-pad-lg why-card-new">
        <span class="why-icon" aria-hidden="true">🔗</span>
        <h3>Built for real workflows</h3>
        <p>Focused interfaces for development, writing, SEO, and design. Contextual links turn isolated tasks into repeatable multi-step workflows.</p>
      </article>
      <article class="tb-card tb-card-interactive tb-card-pad-lg why-card-new">
        <span class="why-icon" aria-hidden="true">🔍</span>
        <h3>Search-first exploration</h3>
        <p>Command-style discovery with <kbd>Ctrl/⌘K</kbd> helps you move from intent to action in seconds.</p>
      </article>
      <article class="tb-card tb-card-interactive tb-card-pad-lg why-card-new">
        <span class="why-icon" aria-hidden="true">🌐</span>
        <h3>Connected ecosystem</h3>
        <p>Cross-linked tools and guides create a discovery layer that grows with your knowledge, not just your bookmark list.</p>
      </article>
      <article class="tb-card tb-card-interactive tb-card-pad-lg why-card-new">
        <span class="why-icon" aria-hidden="true">♾️</span>
        <h3>Free forever by design</h3>
        <p>No freemium gates, no premium tiers. The full toolset is available to everyone, every time.</p>
      </article>
    </div>
  </section>

  <section class="home-section tb-reveal">
    <CategoryHighlights
      categorySlug="developer-tools"
      categoryTitle="Popular categories"
      heroDescription="Explore curated category hubs with built-in cross-linking and workflow context."
      featuredTools={categoryFeatured}
    />
  </section>

  <section class="home-section tb-reveal home-guides-section" aria-labelledby="guides-heading">
    <div class="section-head">
      <h2 id="guides-heading">Learn the tools — free guides</h2>
      <p>Practical explanations with real examples. No fluff, no account needed.</p>
    </div>
    <div class="guides-featured-grid">
      <a href="/guides/base64-encoding-guide.html" class="tb-card tb-card-interactive tb-card-pad-lg guides-featured-card">
        <span class="guides-featured-badge" style="--badge-color:#4A9FE0">Dev</span>
        <h3>Base64 Encoding Explained</h3>
        <p>Binary to text, data URIs, MIME, padding rules, and why Base64 is not encryption.</p>
        <span class="guides-featured-cta">Read guide →</span>
      </a>
      <a href="/guides/json-formatter-guide.html" class="tb-card tb-card-interactive tb-card-pad-lg guides-featured-card">
        <span class="guides-featured-badge" style="--badge-color:#4A9FE0">Dev</span>
        <h3>JSON Formatter Workflow</h3>
        <p>Fix parser errors, normalize quotes, remove trailing commas, choose minify or beautify.</p>
        <span class="guides-featured-cta">Read guide →</span>
      </a>
      <a href="/guides/jwt-decoder-guide.html" class="tb-card tb-card-interactive tb-card-pad-lg guides-featured-card">
        <span class="guides-featured-badge" style="--badge-color:#4A9FE0">Dev</span>
        <h3>JWT Decoder Safety</h3>
        <p>Inspect headers and payloads, read exp and aud, and never confuse decode with verification.</p>
        <span class="guides-featured-cta">Read guide →</span>
      </a>
      <a href="/guides/password-security-guide.html" class="tb-card tb-card-interactive tb-card-pad-lg guides-featured-card">
        <span class="guides-featured-badge" style="--badge-color:#e05a4a">Security</span>
        <h3>Password Security Essentials</h3>
        <p>MFA, managers, breach checks, rotation myths, and safer team sharing rules.</p>
        <span class="guides-featured-cta">Read guide →</span>
      </a>
    </div>
    <div style="text-align:center; margin-top: 1rem;">
      <a href="/guides/" class="tb-btn tb-btn-secondary">All guides →</a>
    </div>
  </section>

  <section class="home-section tb-reveal" aria-labelledby="faq-heading">
    <div class="section-head">
      <h2 id="faq-heading">Frequently asked questions</h2>
      <p>Everything you need to know about ToolBite.</p>
    </div>
    <div class="faq-list">
      {homepageFaq.map((item, i) => (
        <details class="faq-item tb-card tb-card-panel" name="homepage-faq">
          <summary class="faq-question">
            <span class="faq-q-text">{item.question}</span>
            <span class="faq-chevron" aria-hidden="true">›</span>
          </summary>
          <p class="faq-answer">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <Fragment slot="scripts">
  </Fragment>
</BaseLayout>

<style>
  /* Hero starts right after header — remove global main padding-top */
  :global(#main-content) {
    padding-top: 0;
  }
  .home-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0;
    margin-bottom: 1.5rem;
  }
  /* Accent vizual subtil între secțiuni — linie gradient */
  .home-section + .home-section {
    position: relative;
  }
  .home-section + .home-section::before {
    content: '';
    display: block;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(74,159,224,0.12), rgba(255,154,69,0.08), transparent);
    margin-bottom: 1.5rem;
  }
  .home-hero {
    position: relative;
    overflow: hidden;
    max-width: 1200px;
    margin: 1rem auto 0;
    padding: 0;
    padding-bottom: 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--border-subtle, var(--color-border-primary));
    background: var(--bg-secondary, var(--color-bg-secondary));
  }
  .hero-content {
    position: relative;
    z-index: 1;
    padding: clamp(1.25rem, 3vw, 2.5rem) clamp(1.25rem, 4vw, 2.5rem);
  }
  .hero-glow-blue {
    position: absolute;
    top: -80px;
    left: -100px;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(26, 95, 217, 0.15) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-glow-orange {
    position: absolute;
    top: -60px;
    right: -80px;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(245, 166, 35, 0.1) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .stats-bar {
    max-width: 1200px;
    margin-top: 0;
    margin: 0 auto 1.5rem;
    padding: 1rem 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    align-items: center;
    gap: 0.75rem 1rem;
    border-top: 1px solid var(--border-subtle, var(--color-border-primary));
    border-bottom: 1px solid var(--border-subtle, var(--color-border-primary));
    background: transparent;
  }
  .stats-bar .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.25rem;
    min-width: 5.5rem;
  }
  .stats-bar .stat-num {
    font-size: 26px;
    font-weight: 900;
    font-family: var(--font-mono);
    line-height: 1.1;
  }
  .stats-bar .stat-num.blue {
    color: #4d9fff;
  }
  .stats-bar .stat-num.orange {
    color: #f5a623;
  }
  .stats-bar .stat-num.purple {
    color: #a855f7;
  }
  .stats-bar .stat-num.teal {
    color: #2dd4bf;
  }
  .stats-bar .stat-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted, #7A8BAD);
    font-weight: 600;
  }
  .home-popular-kicker {
    font-family: var(--font-mono);
    font-size: 13px;
    margin: 0 0 0.65rem;
    letter-spacing: 0.06em;
  }
  .home-popular-kicker__accent {
    color: var(--accent-orange, #FF9A45);
  }
  .home-popular-kicker__meta {
    color: var(--text-muted, #7A8BAD);
  }
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  @media (max-width: 960px) {
    .tools-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .tools-grid {
      grid-template-columns: 1fr;
    }
  }
  .hero-kicker {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 13px;
    font-weight: 700;
    color: var(--text-muted, #7A8BAD);
    margin-bottom: 0.75rem;
  }
  .terminal-tag {
    font-family: var(--font-mono);
    color: var(--color-brand-blue);
    background: var(--bg-secondary, #0d1e35);
    border: 1px solid var(--color-border-accent-blue);
    padding: 0.375rem 0.875rem;
    border-radius: 4px;
    display: inline-flex;
    margin-bottom: 0.8rem;
  }
  .home-hero h1 {
    margin: 0;
    font-size: clamp(2rem, 4.4vw, 3.6rem);
    line-height: 1.05;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }
  .hero-copy {
    margin-top: 0.9rem;
    max-width: 60ch;
    font-size: clamp(1rem, 1.8vw, 1.12rem);
    color: var(--color-text-secondary);
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1rem; }
  .cta-terminal { font-family: var(--font-mono); }
  .cta-dollar { color: var(--color-brand-orange); }
  .section-head h2 {
    margin: 0;
    font-size: clamp(1.3rem, 3vw, 2rem);
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }
  .section-head p { margin: 0.35rem 0 0.85rem; color: var(--color-text-secondary); }
.discovery-cta,
  .premium-footer {
    background:
      radial-gradient(100% 120% at 90% -20%, rgba(74, 159, 224, 0.18), transparent 62%),
      var(--color-bg-card);
  }
  .discovery-cta h2,
  .premium-footer h2 { margin: 0 0 0.35rem; color: var(--color-text-primary); }
  .discovery-cta p,
  .premium-footer p { margin: 0; color: var(--color-text-secondary); }
  .premium-links { margin-top: 0.85rem; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .premium-links a { color: var(--color-text-secondary); text-decoration: none; border-bottom: 1px solid transparent; }
  .premium-links a:hover { border-bottom-color: var(--color-brand-blue); color: var(--color-brand-blue); }
  .why-section {
    padding: 1.5rem 0;
  }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
    margin-top: 0;
  }
  .why-card-new {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .why-icon {
    font-size: 1.4rem;
    line-height: 1;
    display: block;
    margin-bottom: 0.25rem;
  }
  .why-card-new h3 {
    color: var(--accent-blue, #4A9FE0);
    font-size: 1rem;
    font-weight: 700;
    margin: 0;
  }
  .why-card-new p {
    color: var(--text-secondary, #8BA3C4);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0;
  }
  .why-card-new kbd {
    color: var(--accent-orange, #FF9A45);
    background: rgba(255, 154, 69, 0.08);
    border: 1px solid rgba(255, 154, 69, 0.2);
    border-radius: 4px;
    padding: 0.05rem 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.8em;
  }
  @media (max-width: 900px) {
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .why-grid {
      grid-template-columns: 1fr;
    }
  }
  /* Guides featured */
  .guides-featured-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.85rem;
  }
  @media (max-width: 960px) {
    .guides-featured-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .guides-featured-grid { grid-template-columns: 1fr; }
  }
  .guides-featured-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-decoration: none;
    color: inherit;
  }
  .guides-featured-card h3 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.3;
  }
  .guides-featured-card p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    flex: 1;
  }
  .guides-featured-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    background: color-mix(in srgb, var(--badge-color) 15%, transparent);
    color: var(--badge-color);
    border: 1px solid color-mix(in srgb, var(--badge-color) 30%, transparent);
    align-self: flex-start;
  }
  .guides-featured-cta {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-brand-blue, #4A9FE0);
    margin-top: 0.2rem;
  }

  /* FAQ */
  .faq-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .faq-item {
    padding: 0;
    overflow: hidden;
    border-radius: 10px;
  }
  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.1rem;
    cursor: pointer;
    list-style: none;
    color: var(--text-primary, #E8EDFB);
    font-weight: 600;
    font-size: 0.975rem;
    user-select: none;
  }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-q-text { flex: 1; }
  .faq-chevron {
    font-size: 1.3rem;
    color: var(--accent-blue, #4A9FE0);
    transition: transform 200ms ease;
    flex-shrink: 0;
    line-height: 1;
  }
  .faq-item[open] .faq-chevron { transform: rotate(90deg); }
  .faq-item[open] .faq-question { color: var(--accent-blue, #4A9FE0); }
  .faq-answer {
    margin: 0;
    padding: 0 1.1rem 1rem;
    color: var(--text-secondary, #8BA3C4);
    font-size: 0.9rem;
    line-height: 1.65;
    border-top: 1px solid var(--border-subtle, rgba(255,255,255,0.04));
    padding-top: 0.75rem;
  }
</style>
