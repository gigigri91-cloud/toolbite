---
import CategoryHighlights from "@/components/discovery/CategoryHighlights.astro";
import ToolCard from "@/components/discovery/ToolCard.astro";
import SearchSuggestions from "@/components/search/SearchSuggestions.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { HOMEPAGE_TITLE, createMetadata } from "@/lib/seo";
import { buildOrganizationSchema, buildWebSiteSchema } from "@/lib/schema";
import { getAllTools, getCategoryTools, getPopularTools } from "@/lib/tools";

const toolsTotal = getAllTools().filter(t => t.url.startsWith('tools/')).length;
const title = HOMEPAGE_TITLE;
const description =
  `${toolsTotal} free browser-based tools for JSON formatting, passwords, image compression, and text editing. No account, no upload—100% client-side. Start on ToolBite.`;
const canonicalPath = "/";
const metadata = createMetadata({
  title,
  description,
  canonicalPath,
  keywords: ["browser tools", "developer workflows", "seo tools", "toolbite"]
});

const schemas = [buildWebSiteSchema(), buildOrganizationSchema()];
const popularGridTools = getPopularTools(8);
const categoryFeatured = getCategoryTools("developer-tools").slice(0, 4);
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} metadata={metadata} schemas={schemas}>

  <!-- Hero -->
  <section class="home-hero">
    <div class="hero-glow-blue" aria-hidden="true"></div>
    <div class="hero-glow-orange" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="terminal-tag">▶ {toolsTotal} free tools · no account needed</div>
      <h1>Free tools for developers, writers, and SEO.</h1>
      <p class="hero-copy">
        Format JSON, decode JWTs, compress images, generate passwords — everything runs in your browser, nothing leaves your device.
      </p>
      <div class="hero-actions">
        <a href="/search.html" class="tb-btn tb-btn-primary">Browse all tools</a>
        <a href="/categories/" class="tb-btn tb-btn-secondary">Browse by category</a>
      </div>
      <SearchSuggestions />
    </div>
  </section>

  <!-- Popular tools -->
  <section class="home-section tb-reveal home-popular-tools" aria-labelledby="popular-heading">
    <p class="section-kicker" id="popular-heading">
      <span class="kicker-accent">// popular tools</span>
      <a href="/search.html" class="kicker-link">See all {toolsTotal} →</a>
    </p>
    <div class="tools-grid">
      {popularGridTools.map((tool) => (
        <ToolCard tool={tool} />
      ))}
    </div>
  </section>

  <!-- Category navigation -->
  <section class="home-section tb-reveal">
    <CategoryHighlights
      categorySlug="developer-tools"
      categoryTitle="Browse by category"
      heroDescription="Developer tools, text utilities, image tools, and SEO — pick a category and explore."
      featuredTools={categoryFeatured}
    />
  </section>

  <!-- Guides -->
  <section class="home-section tb-reveal home-guides-section" aria-labelledby="guides-heading">
    <p class="section-kicker" id="guides-heading">
      <span class="kicker-accent">// free guides</span>
      <a href="/guides/" class="kicker-link">All guides →</a>
    </p>
    <div class="guides-featured-grid">
      <a href="/guides/base64-encoding-guide.html" class="tb-card tb-card-interactive tb-card-pad-lg guides-featured-card">
        <span class="guides-featured-badge" style="--badge-color:#4A9FE0">Dev</span>
        <h3>Base64 Encoding Explained</h3>
        <p>Binary to text, data URIs, MIME, padding rules, and why Base64 is not encryption.</p>
        <span class="guides-featured-cta">Read guide →</span>
      </a>
      <a href="/guides/json-formatter-guide.html" class="tb-card tb-card-interactive tb-card-pad-lg guides-featured-card">
        <span class="guides-featured-badge" style="--badge-color:#4A9FE0">Dev</span>
        <h3>JSON Formatter Workflow</h3>
        <p>Fix parser errors, normalize quotes, remove trailing commas, choose minify or beautify.</p>
        <span class="guides-featured-cta">Read guide →</span>
      </a>
      <a href="/guides/jwt-decoder-guide.html" class="tb-card tb-card-interactive tb-card-pad-lg guides-featured-card">
        <span class="guides-featured-badge" style="--badge-color:#4A9FE0">Dev</span>
        <h3>JWT Decoder Safety</h3>
        <p>Inspect headers and payloads, read exp and aud, and never confuse decode with verification.</p>
        <span class="guides-featured-cta">Read guide →</span>
      </a>
      <a href="/guides/password-security-guide.html" class="tb-card tb-card-interactive tb-card-pad-lg guides-featured-card">
        <span class="guides-featured-badge" style="--badge-color:#e05a4a">Security</span>
        <h3>Password Security Essentials</h3>
        <p>MFA, managers, breach checks, rotation myths, and safer team sharing rules.</p>
        <span class="guides-featured-cta">Read guide →</span>
      </a>
    </div>
  </section>

  <Fragment slot="scripts">
  </Fragment>
</BaseLayout>

<style>
  /* Remove global main padding-top — hero starts right after header */
  :global(#main-content) {
    padding-top: 0;
  }

  /* ── Hero ── */
  .home-hero {
    position: relative;
    overflow: hidden;
    max-width: 1200px;
    margin: 1rem auto 0;
    padding-bottom: 1.75rem;
    border-radius: 12px;
    border: 1px solid var(--border-subtle, var(--color-border-primary));
    background: var(--bg-secondary, var(--color-bg-secondary));
  }
  .hero-glow-blue {
    position: absolute;
    top: -80px; left: -100px;
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(26,95,217,0.15) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-glow-orange {
    position: absolute;
    top: -60px; right: -80px;
    width: 300px; height: 300px;
    background: radial-gradient(circle, rgba(245,166,35,0.1) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    padding: clamp(1.5rem, 3vw, 2.75rem) clamp(1.25rem, 4vw, 2.5rem);
  }
  .terminal-tag {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-brand-blue);
    background: var(--bg-secondary, #0d1e35);
    border: 1px solid var(--color-border-accent-blue);
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    display: inline-flex;
    margin-bottom: 1rem;
  }
  .home-hero h1 {
    margin: 0;
    font-size: clamp(1.9rem, 4.4vw, 3.4rem);
    line-height: 1.08;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    max-width: 18ch;
  }
  .hero-copy {
    margin-top: 0.85rem;
    max-width: 54ch;
    font-size: clamp(0.95rem, 1.8vw, 1.08rem);
    color: var(--color-text-secondary);
    line-height: 1.65;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.1rem;
  }

  /* ── Sections ── */
  .home-section {
    max-width: 1200px;
    margin: 2rem auto 0;
    padding: 0;
  }

  .section-kicker {
    font-family: var(--font-mono);
    font-size: 13px;
    margin: 0 0 0.75rem;
    letter-spacing: 0.06em;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .kicker-accent { color: var(--accent-orange, #FF9A45); }
  .kicker-link {
    color: var(--text-muted, #7A8BAD);
    text-decoration: none;
    font-size: 12px;
    transition: color 140ms;
  }
  .kicker-link:hover { color: var(--accent-blue, #4A9FE0); }

  /* ── Tools grid ── */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  @media (max-width: 960px) {
    .tools-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 480px) {
    .tools-grid { grid-template-columns: 1fr; }
  }

  /* ── Guides grid ── */
  .guides-featured-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.85rem;
  }
  @media (max-width: 960px) {
    .guides-featured-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .guides-featured-grid { grid-template-columns: 1fr; }
  }
  .guides-featured-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-decoration: none;
    color: inherit;
  }
  .guides-featured-card h3 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.3;
  }
  .guides-featured-card p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    flex: 1;
  }
  .guides-featured-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    background: color-mix(in srgb, var(--badge-color) 15%, transparent);
    color: var(--badge-color);
    border: 1px solid color-mix(in srgb, var(--badge-color) 30%, transparent);
    align-self: flex-start;
  }
  .guides-featured-cta {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-brand-blue, #4A9FE0);
    margin-top: auto;
    padding-top: 0.4rem;
  }
</style>
